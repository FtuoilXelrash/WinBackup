<Window x:Class="WinBackup.Windows.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinBackup — Reports" Width="1000" Height="580" MinWidth="640" MinHeight="320"
        Icon="/WinBackup.ico"
        Background="{DynamicResource AppWindowBrush}"
        TextElement.Foreground="{DynamicResource AppTextBrush}">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="180"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ListBox x:Name="RunList" DisplayMemberPath="Display" SelectionChanged="Run_Changed"/>
        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>
        <DockPanel Grid.Column="2">
            <TextBlock x:Name="SummaryText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Show:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="LevelCombo" Width="170" SelectedIndex="0" SelectionChanged="Level_Changed">
                    <ComboBoxItem Content="Everything"/>
                    <ComboBoxItem Content="Errors only"/>
                    <ComboBoxItem Content="Errors and warnings"/>
                </ComboBox>
            </StackPanel>
            <DataGrid x:Name="EntryGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      CanUserAddRows="False" GridLinesVisibility="Horizontal" ClipboardCopyMode="IncludeHeader">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat=HH:mm:ss}" Width="70"/>
                    <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="65"/>
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="110"/>
                    <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/>
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="260"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</Window>
