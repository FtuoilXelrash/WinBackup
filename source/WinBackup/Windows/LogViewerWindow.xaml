<Window x:Class="WinBackup.Windows.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinBackup — Log Viewer" Width="760" Height="480" MinWidth="460" MinHeight="260"
        Icon="/WinBackup.ico"
        Background="{DynamicResource AppWindowBrush}"
        TextElement.Foreground="{DynamicResource AppTextBrush}">
    <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Log:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="FileCombo" Width="230" DisplayMemberPath="Name" SelectionChanged="Selection_Changed"/>
            <Button Content="Open Folder" Padding="10,3" Margin="8,0,0,0" Click="OpenFolder_Click"/>
            <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="16,0,6,0"/>
            <TextBox x:Name="FilterBox" VerticalContentAlignment="Center" TextChanged="Filter_Changed"/>
        </DockPanel>
        <TextBox x:Name="LogText" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
    </DockPanel>
</Window>
