<Window x:Class="WinBackup.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:WinBackup.Models"
        Title="WinBackup — Settings" Width="620" Height="520"
        Icon="/WinBackup.ico" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppWindowBrush}"
        TextElement.Foreground="{DynamicResource AppTextBrush}">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="80" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Apply" Width="80" Margin="8,0,0,0" Click="Apply_Click"/>
        </StackPanel>

        <TabControl x:Name="Tabs">
            <TabItem Header="General">
                <StackPanel x:Name="GeneralPanel" Margin="16,12">
                    <TextBlock Text="General Behavior" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <CheckBox Content="Close to system tray when window is closed" IsChecked="{Binding CloseToTray}" Margin="0,4"/>
                    <CheckBox Content="Confirm before exiting" IsChecked="{Binding ConfirmExit}" Margin="0,4"/>
                    <CheckBox Content="Start minimized (tray only, no window on launch)" IsChecked="{Binding StartMinimized}" Margin="0,4"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Windows">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <StackPanel x:Name="WindowsPanel">
                        <TextBlock Text="Appearance" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Theme:" Width="80" VerticalAlignment="Center"/>
                            <ComboBox Width="120" SelectedValuePath="Tag" SelectedValue="{Binding Theme}">
                                <ComboBoxItem Content="Light" Tag="{x:Static m:AppTheme.Light}"/>
                                <ComboBoxItem Content="Dark" Tag="{x:Static m:AppTheme.Dark}"/>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Text="Main Window" FontWeight="SemiBold" Margin="0,14,0,6"/>
                        <CheckBox Content="Always on top" IsChecked="{Binding Windows.Main.AlwaysOnTop}" Margin="0,3"/>
                        <CheckBox Content="Show in the taskbar" IsChecked="{Binding Windows.Main.ShowInTaskbar}" Margin="0,3"/>

                        <TextBlock Text="Settings Window" FontWeight="SemiBold" Margin="0,14,0,6"/>
                        <CheckBox Content="Always on top" IsChecked="{Binding Windows.Settings.AlwaysOnTop}" Margin="0,3"/>
                        <CheckBox Content="Show in the taskbar" IsChecked="{Binding Windows.Settings.ShowInTaskbar}" Margin="0,3"/>

                        <TextBlock Text="Profile Editor" FontWeight="SemiBold" Margin="0,14,0,6"/>
                        <CheckBox Content="Always on top" IsChecked="{Binding Windows.ProfileEditor.AlwaysOnTop}" Margin="0,3"/>
                        <CheckBox Content="Show in the taskbar" IsChecked="{Binding Windows.ProfileEditor.ShowInTaskbar}" Margin="0,3"/>

                        <TextBlock Text="Log Viewer" FontWeight="SemiBold" Margin="0,14,0,6"/>
                        <CheckBox Content="Always on top" IsChecked="{Binding Windows.LogViewer.AlwaysOnTop}" Margin="0,3"/>
                        <CheckBox Content="Show in the taskbar" IsChecked="{Binding Windows.LogViewer.ShowInTaskbar}" Margin="0,3"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Logging">
                <StackPanel Margin="16,12">
                    <TextBlock Text="Retention" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Keep logs and reports for" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding LogRetentionDays}" Width="50" Margin="8,0" TextAlignment="Center"/>
                        <TextBlock Text="days (0 = forever)" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
