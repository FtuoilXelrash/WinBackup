<Window x:Class="WinBackup.Windows.MiniStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinBackup — MINI Status" Width="260" Height="300" MinWidth="200" MinHeight="150"
        Icon="/WinBackup.ico" MouseDoubleClick="Window_DoubleClick"
        Background="{DynamicResource AppWindowBrush}"
        TextElement.Foreground="{DynamicResource AppTextBrush}">
    <Window.ContextMenu>
        <ContextMenu Opened="Menu_Opened">
            <MenuItem x:Name="TopmostItem" Header="Always on Top" IsCheckable="True" Click="Topmost_Click"/>
            <MenuItem Header="Open WinBackup" Click="Open_Click"/>
        </ContextMenu>
    </Window.ContextMenu>
    <DockPanel Margin="8">
        <StackPanel x:Name="ProgressPanel" DockPanel.Dock="Bottom" Margin="0,8,0,0" Visibility="Collapsed">
            <TextBlock x:Name="ProgressText" FontSize="11" TextTrimming="CharacterEllipsis"/>
            <ProgressBar x:Name="ProgressBar" Height="8" Maximum="100" Margin="0,4,0,0"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ProfileList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,3" ToolTip="{Binding Detail}" Background="Transparent">
                            <Ellipse Width="9" Height="9" Fill="{Binding Color}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" FontSize="10"
                                       Foreground="{DynamicResource AppSubtextBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
