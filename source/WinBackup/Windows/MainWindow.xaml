<Window x:Class="WinBackup.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinBackup.ViewModels"
        Title="WinBackup" Width="920" Height="580" MinWidth="680" MinHeight="400"
        Icon="/WinBackup.ico"
        Background="{DynamicResource AppWindowBrush}"
        TextElement.Foreground="{DynamicResource AppTextBrush}"
        Closing="Window_Closing">
    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Profile..." Click="NewProfile_Click"/>
                <MenuItem Header="New _Folder..." Click="NewFolder_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Profile">
                <MenuItem Header="_Edit..." Click="Edit_Click" InputGestureText="Enter"/>
                <MenuItem Header="_Copy" Click="Copy_Click"/>
                <MenuItem Header="Re_name..." Click="Rename_Click" InputGestureText="F2"/>
                <MenuItem Header="_Delete" Click="Delete_Click" InputGestureText="Del"/>
            </MenuItem>
            <MenuItem x:Name="RunMenu" Header="_Run">
                <MenuItem Header="Pre_view..." Click="Preview_Click"/>
                <MenuItem Header="_Start Selected" Click="Run_Click" InputGestureText="F5"/>
                <MenuItem Header="Start _All Enabled" Click="RunAll_Click"/>
                <Separator/>
                <MenuItem Header="_Pause / Resume" Click="Pause_Click"/>
                <MenuItem Header="_Cancel" Click="CancelJobs_Click"/>
            </MenuItem>
            <MenuItem x:Name="ViewMenu" Header="_View"/>
            <MenuItem Header="_Help">
                <MenuItem Header="_Help Contents..." Click="Help_Click" InputGestureText="F1"/>
                <Separator/>
                <MenuItem Header="_About WinBackup..." Click="About_Click"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Height="24">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True"/>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="VersionLabel" FontSize="11" Foreground="{DynamicResource AppSubtextBrush}"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="StatusLabel" FontSize="11" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>

        <WrapPanel x:Name="ToolPanel" DockPanel.Dock="Top" Margin="6,4">
            <Button Content="New Profile" Padding="10,3" Margin="0,0,6,0" Click="NewProfile_Click"/>
            <Button Content="Edit" Padding="10,3" Margin="0,0,16,0" Click="Edit_Click"/>
            <Button Content="Preview" Padding="10,3" Margin="0,0,6,0" Click="Preview_Click"/>
            <Button Content="Start" Padding="10,3" Margin="0,0,6,0" Click="Run_Click"/>
            <Button Content="Start All" Padding="10,3" Margin="0,0,6,0" Click="RunAll_Click"/>
        </WrapPanel>

        <Border x:Name="JobPanel" DockPanel.Dock="Bottom" Margin="6,0,6,6" Padding="10,8" Visibility="Collapsed"
                BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}"
                Background="{DynamicResource AppPanelBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button x:Name="PauseButton" Content="Pause" Width="80" Click="Pause_Click"/>
                    <Button Content="Cancel" Width="80" Margin="6,0,0,0" Click="CancelJobs_Click"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="JobTitle" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar x:Name="JobProgressBar" Height="10" Margin="0,5" Maximum="100"/>
                    <TextBlock x:Name="JobPath" FontSize="11" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource AppSubtextBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid x:Name="ContentArea" Margin="6,0,6,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="180"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TreeView x:Name="ProfileTree" MouseDoubleClick="Tree_DoubleClick" KeyDown="Tree_KeyDown"
                      PreviewMouseRightButtonDown="Tree_RightButtonDown">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:ProfileNode}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,5,0">
                                <CheckBox.Style>
                                    <Style TargetType="CheckBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </CheckBox.Style>
                            </CheckBox>
                            <TextBlock Text="{Binding Name}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
                <TreeView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Preview..." Click="Preview_Click"/>
                        <MenuItem Header="Start" Click="Run_Click"/>
                        <Separator/>
                        <MenuItem Header="Edit..." Click="Edit_Click"/>
                        <MenuItem Header="Copy" Click="Copy_Click"/>
                        <MenuItem Header="Rename..." Click="Rename_Click"/>
                        <MenuItem Header="Delete" Click="Delete_Click"/>
                        <Separator/>
                        <MenuItem Header="New Profile..." Click="NewProfile_Click"/>
                        <MenuItem Header="New Folder..." Click="NewFolder_Click"/>
                    </ContextMenu>
                </TreeView.ContextMenu>
            </TreeView>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

            <Border Grid.Column="2" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}"
                    Background="{DynamicResource AppPanelBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <StackPanel>
                        <TextBlock x:Name="DetailTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailText" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
