<Window x:Class="WinBackup.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About WinBackup" Width="340" SizeToContent="Height"
        Icon="/WinBackup.ico" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBrush}"
        TextElement.Foreground="{DynamicResource AppTextBrush}">
    <StackPanel Margin="24">
        <Image Source="/WinBackup.png" Width="96" Height="96" Margin="0,0,0,14"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="WinBackup" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Text="Windows backup utility" Foreground="{DynamicResource AppSubtextBrush}"
                   HorizontalAlignment="Center" Margin="0,2,0,18"/>
        <Grid HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="Version:" Foreground="{DynamicResource AppSubtextBrush}" Margin="0,3"/>
            <TextBlock x:Name="VersionLabel" Grid.Column="1" Margin="0,3"/>
            <TextBlock Grid.Row="1" Text="Developer:" Foreground="{DynamicResource AppSubtextBrush}" Margin="0,3"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="Ftuoil Xelrash" Margin="0,3"/>
            <TextBlock Grid.Row="2" Text="Platform:" Foreground="{DynamicResource AppSubtextBrush}" Margin="0,3"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="Windows x64 / .NET 10" Margin="0,3"/>
            <TextBlock Grid.Row="3" Text="License:" Foreground="{DynamicResource AppSubtextBrush}" Margin="0,3"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="GNU GPL v3" Margin="0,3"/>
        </Grid>
        <Button Content="Close" Width="80" Margin="0,18,0,0" IsCancel="True" IsDefault="True"/>
    </StackPanel>
</Window>
