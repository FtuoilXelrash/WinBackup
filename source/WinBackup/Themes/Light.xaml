<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppWindowBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppPanelBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="AppTextBrush" Color="#212121"/>
    <SolidColorBrush x:Key="AppSubtextBrush" Color="#6B6B6B"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="#DCDCDC"/>
    <SolidColorBrush x:Key="AppInputBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="ActionCopyToDestinationBrush" Color="#D9F2D6"/>
    <SolidColorBrush x:Key="ActionCopyToSourceBrush" Color="#D6E8FB"/>
    <SolidColorBrush x:Key="ActionDeleteDestinationBrush" Color="#FAD4D4"/>
    <SolidColorBrush x:Key="ActionDeleteSourceBrush" Color="#F2D9F2"/>
    <SolidColorBrush x:Key="ActionSkipBrush" Color="#FFEDB8"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#C5DCFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E2EDFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#212121"/>

    <Style TargetType="{x:Type DataGridCell}">
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

</ResourceDictionary>
